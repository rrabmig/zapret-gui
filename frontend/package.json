{
  "name": "zapret-gui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node ../scripts/check-frontend-size.mjs",
    "build:fixtures": "npm run typecheck && vite build --mode fixtures",
    "preview:fixtures": "vite preview --outDir dist-fixtures --host 127.0.0.1 --port 4173 --strictPort",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "storybook": "10.6.3",
    "storybook-addon-pseudo-states": "10.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@axe-core/playwright": "4.14.0"
  }
}
